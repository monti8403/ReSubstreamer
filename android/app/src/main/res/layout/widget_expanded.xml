<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Upper Row: Current Playback Track Info & Full Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Track Cover -->
            <ImageView
                android:id="@+id/widget_cover"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_widget_default_cover"
                android:contentDescription="@string/widget_name" />

            <!-- Title & Artist -->
            <LinearLayout
                android:id="@+id/layout_track_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/widget_no_track"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/widget_ready_to_play"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Transport & Action Controls -->
            <LinearLayout
                android:id="@+id/layout_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btn_star"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_heart"
                    android:contentDescription="Star" />

                <ImageView
                    android:id="@+id/btn_shuffle"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_shuffle"
                    android:contentDescription="Shuffle" />

                <ImageView
                    android:id="@+id/btn_prev"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_prev"
                    android:contentDescription="Previous" />

                <FrameLayout
                    android:id="@+id/container_play_pause"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp">

                    <ImageView
                        android:id="@+id/btn_play_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_play_btn_bg"
                        android:scaleType="fitXY"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/btn_play_pause"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_play"
                        android:contentDescription="Play/Pause" />

                    <ProgressBar
                        android:id="@+id/widget_loading_spinner"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="#FFFFFF"
                        android:visibility="gone" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/btn_next"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_next"
                    android:contentDescription="Next" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#1AFFFFFF"
            android:contentDescription="@null" />

        <!-- Lower Row: 4 Fixed Recent Items -->
        <LinearLayout
            android:id="@+id/layout_recents_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Card 1 -->
            <LinearLayout
                android:id="@+id/card_recent_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="4dp"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/recent_cover_1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_widget_default_cover"
                    android:contentDescription="Recent 1" />

                <TextView
                    android:id="@+id/recent_title_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:text="Recent 1"
                    android:textColor="#D9FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Card 2 -->
            <LinearLayout
                android:id="@+id/card_recent_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/recent_cover_2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_widget_default_cover"
                    android:contentDescription="Recent 2" />

                <TextView
                    android:id="@+id/recent_title_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:text="Recent 2"
                    android:textColor="#D9FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Card 3 -->
            <LinearLayout
                android:id="@+id/card_recent_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/recent_cover_3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_widget_default_cover"
                    android:contentDescription="Recent 3" />

                <TextView
                    android:id="@+id/recent_title_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:text="Recent 3"
                    android:textColor="#D9FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Card 4 -->
            <LinearLayout
                android:id="@+id/card_recent_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="4dp"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/recent_cover_4"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_widget_default_cover"
                    android:contentDescription="Recent 4" />

                <TextView
                    android:id="@+id/recent_title_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:text="Recent 4"
                    android:textColor="#D9FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
