<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Upper Section: Current Playback Track Info & Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Large Cover (72x72dp) -->
            <ImageView
                android:id="@+id/widget_cover"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_widget_default_cover"
                android:contentDescription="@string/widget_name" />

            <!-- Track Info & Controls -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <!-- Title, Artist & Top-Right Buttons (Star + Shuffle) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:id="@+id/layout_track_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:text="@string/widget_no_track"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:text="@string/widget_ready_to_play"
                            android:textColor="#B3FFFFFF"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btn_star"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="5dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_widget_heart"
                            android:contentDescription="Star" />

                        <ImageView
                            android:id="@+id/btn_shuffle"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="5dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_widget_shuffle"
                            android:contentDescription="Shuffle" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Transport controls below title/artist -->
                <LinearLayout
                    android:id="@+id/layout_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/btn_prev"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_prev"
                        android:contentDescription="Previous" />

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp">

                        <ImageView
                            android:id="@+id/btn_play_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/widget_play_btn_bg"
                            android:scaleType="fitXY"
                            android:contentDescription="@null" />

                        <ImageView
                            android:id="@+id/btn_play_pause"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_widget_play"
                            android:contentDescription="Play/Pause" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/btn_next"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_next"
                        android:contentDescription="Next" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="#1FFFFFFF" />

        <!-- Bottom Section: Recents Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/text_recent_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_recent_title"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Quick Shuffle Button -->
            <LinearLayout
                android:id="@+id/btn_quick_shuffle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/widget_recent_item_bg">

                <ImageView
                    android:id="@+id/ic_quick_shuffle"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_widget_shuffle"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/widget_shuffle"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4 Fixed Recent Cards -->
        <LinearLayout
            android:id="@+id/layout_recents_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Card 1 -->
            <LinearLayout
                android:id="@+id/card_recent_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="4dp"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/recent_cover_1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_widget_default_cover"
                    android:contentDescription="Recent 1" />

                <TextView
                    android:id="@+id/recent_title_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:textColor="#E6FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Card 2 -->
            <LinearLayout
                android:id="@+id/card_recent_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/recent_cover_2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_widget_default_cover"
                    android:contentDescription="Recent 2" />

                <TextView
                    android:id="@+id/recent_title_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:textColor="#E6FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Card 3 -->
            <LinearLayout
                android:id="@+id/card_recent_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/recent_cover_3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_widget_default_cover"
                    android:contentDescription="Recent 3" />

                <TextView
                    android:id="@+id/recent_title_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:textColor="#E6FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Card 4 -->
            <LinearLayout
                android:id="@+id/card_recent_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="4dp"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/recent_cover_4"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_widget_default_cover"
                    android:contentDescription="Recent 4" />

                <TextView
                    android:id="@+id/recent_title_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:textColor="#E6FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
