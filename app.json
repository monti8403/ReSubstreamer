{
  "expo": {
    "name": "Atrum",
    "slug": "atrum",
    "version": "8.0.92",
    "scheme": "atrum",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.monti.atrum",
      "buildNumber": "177",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Atrum uses your local network to connect to your self-hosted music server.",
        "NSBonjourServices": [
          "_googlecast._tcp",
          "_CC1AD845._googlecast._tcp"
        ],
        "NSLocationWhenInUseUsageDescription": "Location access is needed to detect your WiFi network name for automatic offline mode switching.",
        "INAlternativeAppNames": [
          {
            "INAlternativeAppName": "Atrum",
            "INAlternativeAppNamePronunciationHint": "Atrum"
          }
        ]
      },
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true,
        "com.apple.developer.carplay-audio": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 80000177,
      "package": "com.monti.atrum"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-bootsplash",
        {
          "logo": "./assets/splash-icon.png",
          "logoWidth": 200,
          "background": "#000000"
        }
      ],
      "./plugins/silence-hermes-warning",
      "./plugins/silence-dev-launcher-warning",
      "./plugins/dedupe-lc++",
      "./plugins/fix-jvm-target",
      "./plugins/large-heap",
      "./plugins/set-gradle-version",
      "./plugins/with-gradle-memory",
      "./plugins/with-proguard-optimize",
      "./modules/expo-ssl-trust/plugin",
      "./modules/expo-backup-exclusions/plugin",
      [
        "react-native-queue-player",
        {
          "carplay": true,
          "siri": true,
          "chromecast": true,
          "chromecastReceiverAppId": "CC1AD845"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "usePrecompiledHeaders": true
          }
        }
      ],
      "expo-screen-orientation",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "./plugins/location-feature-optional",
      "./plugins/strip-push-entitlement",
      "./plugins/with-disable-sync-mount-props-override",
      "./plugins/with-android-app-actions",
      "./plugins/with-carplay-appearance-fix",
      [
        "expo-notifications",
        {
          "icon": "./assets/ic_stat_atrum.png",
          "color": "#000000"
        }
      ],
      "expo-sharing",
      "expo-localization",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-design-icons"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6cbe0036-3542-49a1-86af-e7a589d094cb"
      }
    },
    "owner": "monti84"
  }
}
